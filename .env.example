# ------------------------------------------------------------------
# SPI Training Management Platform — environment configuration
# Copy this file to .env.local and fill in real values before
# connecting the app to a live Supabase/PostgreSQL project.
# Never commit .env.local or real secrets to version control.
# ------------------------------------------------------------------

# Public app URL (used for links in emails, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings (safe to expose to the browser).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is Supabase's current naming
# for this key; NEXT_PUBLIC_SUPABASE_ANON_KEY (older projects) also
# works if that's what your project dashboard shows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — SERVER-SIDE ONLY.
# Never prefix this with NEXT_PUBLIC_ and never import it into
# client components. Used only inside server-only repository code.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Authentication mode
# ------------------------------------------------------------------
# "supabase" — real Supabase Auth. This is the production path;
#              requires the Supabase vars above to be set.
# "demo"     — no Supabase project needed. Uses the built-in demo
#              accounts (see README) so the app is testable locally
#              before a Supabase project exists. Local development
#              convenience ONLY — never intended for production.
#
# Leave unset to auto-detect: Supabase is used automatically once the
# vars above are filled in, demo mode otherwise (dev only). Demo mode
# can never be enabled in a production build (NODE_ENV=production) —
# NEXT_PUBLIC_AUTH_MODE=demo is ignored there — so an
# unconfigured production deploy fails safely with a clear
# "authentication isn't configured" message instead of silently
# exposing the demo accounts.
NEXT_PUBLIC_AUTH_MODE=
